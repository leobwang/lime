#!/bin/sh
# lime — validate the plan tree before every commit (lime-spec-v1.md §1.3, §14).
#
# Enable it once, from the repository root:
#
#     git config core.hooksPath plan/.githooks
#
# `lime check` exits 0 when the tree is clean and 2 when it has validation
# problems (duplicate ids, dangling parents, cycles, bad values); anything
# non-zero aborts the commit. Bypass one commit with `git commit --no-verify`.

set -u

plan=$(CDPATH='' cd -- "$(dirname -- "$0")/.." && pwd) || exit 1

if ! command -v lime >/dev/null 2>&1; then
	echo "pre-commit: lime is not on PATH — skipping lime check" >&2
	exit 0
fi

exec lime check --dir "$plan"
